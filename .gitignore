# ============================================================================
# .gitignore - Reconocimiento de Emociones Faciales
# ============================================================================

# ── Entornos Virtuales de Python ──────────────────────────────────────────────
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ── Bytecode y Caché de Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# ── Archivos de Configuración de IDEs ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# ── Cuadernos de Jupyter ──────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Archivos del Sistema Operativo ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Modelos Pesados y Checkpoints (.pth, .pt, .onnx, .data) ───────────────────
*.pth
*.pt
*.onnx
*.onnx.data
*.bin
*.ckpt
outputs/models/*
!outputs/models/.gitkeep

# ── Paquetes Exportados y Archivos Comprimidos (.zip, .tar, .rar) ────────────
*.zip
*.tar
*.tar.gz
*.rar
*.7z
outputs/*.zip
Emotion_AI_Portable_*.zip

# ── Capturas de Pantalla y Fotos de Prueba en Tiempo Real ────────────────────
outputs/plots/screenshot_*.png
screenshot_*.png
captura_*.png
*.png.tmp

# ── Logs y Archivos Temporales ───────────────────────────────────────────────
*.log
temp/
tmp/
bundle/
